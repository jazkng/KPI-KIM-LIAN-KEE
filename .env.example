# Gemini API credentials
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Smart Localization V2: low-cost terms/UI + stronger natural workplace language.
GEMINI_TRANSLATION_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSLATION_SMART_MODEL=gemini-3.5-flash
# Optional backwards-compatible alias for the lite model:
# GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite

# Firebase client-side credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AP AI Service URL
VITE_AP_AI_API_URL=https://ap-ai-service-xxx.a.run.app

# V2 开发：设为 true 时完全改用本机 Firebase Emulator（demo-klk-erp），不会连正式项目
# 用法：先 `npm run emulators`，再在另一个终端 `npm run dev:emulator`
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
