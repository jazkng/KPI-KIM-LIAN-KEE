rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function employeeLogin() {
      return signedIn()
        && request.auth.token.emp is string
        && request.auth.token.emp != ''
        && request.auth.uid == 'emp_' + request.auth.token.emp;
    }

    function employee(id) {
      return get(/databases/$(database)/documents/employees/$(id)).data;
    }

    function department(value) {
      return value == 'BOH' ? 'KITCHEN' : value == 'FOH' ? 'FLOOR' : value;
    }

    function scoreLimit() {
      return request.auth.token.lvl == 'TEAM_LEAD' ? 3
        : request.auth.token.lvl == 'DEPARTMENT_HEAD' ? 4
        : request.auth.token.lvl in ['OWNER', 'BRANCH_MANAGER', 'STAFF_SUPPORT'] ? 5 : 0;
    }

    function canScore(targetId) {
      let actor = employee(request.auth.token.emp);
      let target = employee(targetId);
      let level = request.auth.token.lvl;
      let targetLevel = target.get('orgLevel', '');
      let targetDepartment = department(target.get('department', ''));
      let actorDepartment = department(actor.get('department', ''));
      return targetId != request.auth.token.emp
        && actor.get('orgLevel', '') == level
        && targetLevel != 'OWNER'
        && (
          level in ['OWNER', 'BRANCH_MANAGER', 'STAFF_SUPPORT']
          || (level in ['DEPARTMENT_HEAD', 'TEAM_LEAD']
              && targetLevel == 'CREW'
              && targetDepartment != ''
              && (targetDepartment == actorDepartment
                  || targetDepartment in actor.get('hygieneDepartments', [])))
        );
    }

    function validMonday(value) {
      let parts = value.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && day.year() == int(parts[0])
        && day.month() == int(parts[1])
        && day.day() == int(parts[2])
        && day.dayOfWeek() == 1;
    }

    function validHygiene(id) {
      let check = request.resource.data;
      return employeeLogin()
        && request.auth.token.get('ro', false) != true
        && check.keys().hasOnly(['id', 'employeeId', 'weekStart', 'score', 'note', 'checkedBy', 'checkedByName', 'at'])
        && check.keys().hasAll(['id', 'employeeId', 'weekStart', 'score', 'checkedBy', 'checkedByName', 'at'])
        && check.id == id
        && check.employeeId is string
        && check.weekStart is string
        && validMonday(check.weekStart)
        && id == check.weekStart + '_' + check.employeeId
        && check.checkedBy == request.auth.token.emp
        && check.score is int
        && check.score >= 1
        && check.score <= scoreLimit()
        && check.checkedByName is string
        && check.at is string
        && (check.score == 3 || (check.get('note', '') is string && check.get('note', '').size() > 0))
        && canScore(check.employeeId);
    }

    // V2-only collection: keep V1's other reads/writes while V1 is still active.
    match /hygiene_checks/{id} {
      allow read: if signedIn();
      allow create: if validHygiene(id);
      allow update: if validHygiene(id)
        && resource.data.checkedBy == request.auth.token.emp
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.weekStart == resource.data.weekStart;
      allow delete: if false;
    }

    match /{collection}/{document=**} {
      allow read, write: if signedIn() && collection != 'hygiene_checks';
    }
  }
}
