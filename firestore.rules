rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 御膳智控 - 第一道门 (Phase 1: Identity Gate)
    // -------------------------------------------------------------------------
    // 目前系统用本地 PIN 登入，Firestore 层面还没有角色概念，
    // 所以这一版只做一件事：要求「必须持有 Firebase 身份」。
    //
    // 挡得住：公网扫描器、直接调 REST API 的陌生人、拿到 projectId 就来拖库的人
    // 挡不住：已经登入 App 的内部人（这需要 Phase 2 的 custom claims）
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}